{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.url     | string                |             |
| page.slug    | string                |             |
| page.type    | string                |             |

  AZEL — info pages (من نحن، سياسة الضمان والاسترجاع، الشحن…) drawn with the
  design's dark page head and a white prose card.
#}
{% extends "layouts.master" %}
{% block styles_after %}
    <link rel="stylesheet" href="{{ 'azel-catalog.css' | asset }}">
{% endblock %}
{% block content %}
{% set title = (page.title is iterable ? page.title[user.language.code]|default(page.title|first) : page.title) %}

{% if page.type == 'customised' %}
    {#
        Hook: information_page.information_page
        Fires before the main informative page content section.
    #}
    <div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
{% else %}
    <section class="page-hero az">
        <div class="container">
            <nav class="crumbs" aria-label="{{ trans('azel.common.breadcrumbs') }}"><salla-breadcrumb></salla-breadcrumb></nav>
            <h1>{{ title }}</h1>
        </div>
    </section>
    <section class="section-sm az">
        <div class="container info-wrap">
            <div class="policy-body">
                <div class="prose content-entry">{{ page.content|raw }}</div>
            </div>
            <div class="info-comments"><salla-comments item-id="{{ page.id }}" type="page"></salla-comments></div>
        </div>
    </section>
{% endif %}
{% endblock %}
